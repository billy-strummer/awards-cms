# ==================================================
# British Trade Awards CMS - Environment Variables
# ==================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Resend.com (Email)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=awards@britishtrade.com
FROM_NAME=British Trade Awards

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY is intentionally NOT set here — see note near the bottom
# of this file. It's entered into the CMS itself (Settings/Events), not deployed
# as an environment variable.

# Anthropic (AI Vetting)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Sentry (Error Monitoring) — optional; Sentry stays disabled if unset
SENTRY_DSN=https://xxxxxxxxxxxx@o123456.ingest.sentry.io/123456

# Branding
BTA_LOGO_URL=https://admin.britishtradeawards.com/assets/british-trade-awards-logo.png

# Twitter/X API — OAuth 1.0a, all four required together (a bearer token alone is not enough to post)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_ORG_ID=your-linkedin-org-id

# Facebook / Instagram API
FACEBOOK_PAGE_TOKEN=your-facebook-page-token
FACEBOOK_PAGE_ID=your-facebook-page-id
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# Application
# NODE_ENV is set automatically by Vercel — do not set it manually in Vercel's env var UI.
# PORT is not used on Vercel (serverless has no listening port) — only relevant if
# api/_lib/automation-scheduler.js is ever run as a standalone long-lived process.
APP_URL=https://admin.britishtradeawards.com

# CORS - comma-separated list of allowed origins for data-proxy.js (optional; defaults to APP_URL)
ALLOWED_ORIGINS=https://admin.britishtradeawards.com,https://britishtradeawards.com

# Contact email shown in payment receipts and fallback email footers (falls back to FROM_EMAIL if unset)
CONTACT_EMAIL=awards@britishtrade.com

# Non-production safety net: when NODE_ENV isn't "production", all outgoing Resend
# emails are redirected to this address instead of real recipients, if set.
DEV_EMAIL=you@example.com

# Resend webhook signing secret — verifies delivery/bounce webhook payloads in
# api/email-automation.js. Get it from Resend Dashboard > Webhooks after creating one.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Note: STRIPE_PUBLISHABLE_KEY is NOT read from environment variables — it is not
# secret, so it's entered directly into the CMS via Settings/Events (stored in the
# browser's localStorage as `bta_stripe_pk`) rather than baked in at build/deploy time.
