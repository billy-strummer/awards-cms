{
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint *.js api/*.js",
    "lint:fix": "eslint *.js api/*.js --fix",
    "format": "prettier --write '*.js' 'api/*.js' 'tests/*.js'",
    "format:check": "prettier --check '*.js' 'api/*.js' 'tests/*.js'",
    "test": "jest tests/ --forceExit",
    "test:coverage": "jest tests/ --forceExit --coverage",
    "typecheck": "node typecheck.js",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "build": "node build.js",
    "prepare": "husky"
  },
  "dependencies": {
    "esbuild": "^0.27.3"
  },
  "devDependencies": {
    "cssnano": "^7.1.2",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^24.1.3",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --quiet"
    ],
    "api/*.js": [
      "prettier --write",
      "eslint --quiet"
    ]
  }
}
