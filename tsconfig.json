{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "target": "ES2020",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["*.js", "api/**/*.js"],
  "exclude": ["node_modules", "dist", "tests"]
}
