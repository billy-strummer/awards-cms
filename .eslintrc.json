{
  "env": {
    "browser": true,
    "es2020": true
  },
  "globals": {
    "bootstrap": "readonly",
    "supabase": "readonly",
    "Stripe": "readonly",
    "Chart": "readonly",
    "XLSX": "readonly",
    "L": "readonly",
    "Sentry": "readonly",
    "jsPDF": "readonly",
    "jspdf": "readonly",
    "Choices": "readonly",
    "uploadApp": "readonly",
    "ModuleRegistry": "readonly",
    "STATE": "readonly",
    "SUPABASE_CONFIG": "readonly",
    "STATUS": "readonly",
    "MEDIA_TYPES": "readonly",
    "INACTIVITY_TIMEOUT": "readonly",
    "YEARS": "readonly",
    "SECTORS": "readonly",
    "REGIONS": "readonly",
    "utils": "readonly",
    "apiClient": "readonly",
    "actionRegistry": "readonly",
    "serverQuery": "readonly",
    "authModule": "readonly",
    "awardsModule": "readonly",
    "orgsModule": "readonly",
    "entriesModule": "readonly",
    "winnersModule": "readonly",
    "eventsModule": "readonly",
    "paymentsModule": "readonly",
    "crmModule": "readonly",
    "dashboardModule": "readonly",
    "rbacModule": "readonly",
    "securityModule": "readonly",
    "emailBuilder": "readonly",
    "emailTemplatesModule": "readonly",
    "emailListsModule": "readonly",
    "mediaGalleryModule": "readonly",
    "socialMediaModule": "readonly",
    "assignmentsModule": "readonly",
    "settingsModule": "readonly",
    "gdprModule": "readonly",
    "stripeFrontend": "readonly",
    "tenantModule": "readonly",
    "multiTenancyModule": "readonly",
    "testDataManager": "readonly",
    "reportingModule": "readonly",
    "sponsorPortalModule": "readonly",
    "ticketModule": "readonly",
    "notificationsModule": "readonly",
    "entryRevisionModule": "readonly",
    "brandingModule": "readonly",
    "webhooksModule": "readonly",
    "documentModule": "readonly",
    "calendarModule": "readonly",
    "winnerAnnouncementsModule": "readonly",
    "reportsScheduler": "readonly",
    "aiVettingModule": "readonly",
    "marketingModule": "readonly",
    "a11yModule": "readonly",
    "i18n": "readonly",
    "nomineeVoting": "readonly",
    "winnerPipelineModule": "readonly",
    "rateLimitModule": "readonly",
    "seatingEnhancements": "readonly",
    "reportsAnalytics": "readonly",
    "judgePortal": "readonly",
    "showPublicToast": "readonly",
    "esc": "readonly",
    "updateTabCounts": "readonly",
    "TradingView": "readonly",
    "locationModule": "readonly",
    "areasManager": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-redeclare": ["error", { "builtinGlobals": false }],
    "no-constant-condition": "warn",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-extra-semi": "warn",
    "no-unreachable": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-throw-literal": "warn",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn",
    "prefer-const": ["warn", { "destructuring": "all" }],
    "no-var": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "MemberExpression[object.property.name='client'][property.name='from']",
        "message": "Prefer apiClient.select/insert/update/delete over STATE.client.from() for server-side security."
      }
    ]
  },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      "files": [
        "build.js",
        "check-schema.js",
        "diagnose.js",
        "bulk-csv-importer.js",
        "jest.config.js",
        "jest-esm-transform.js",
        "scripts/**/*.js"
      ],
      "env": {
        "node": true,
        "browser": false
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["api/**/*.js"],
      "env": {
        "node": true,
        "browser": false
      },
      "globals": {},
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "env": {
        "jest": true,
        "node": true
      },
      "rules": {
        "no-restricted-syntax": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["__mocks__/**/*.js"],
      "env": {
        "jest": true,
        "node": true
      }
    },
    {
      "files": ["auth.js", "config.js", "utils.js", "test-data-manager.js", "diagnose.js"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
