{
  "env": {
    "browser": true,
    "es2020": true
  },
  "globals": {
    "ModuleRegistry": "readonly",
    "STATE": "readonly",
    "SUPABASE_CONFIG": "readonly",
    "STATUS": "readonly",
    "MEDIA_TYPES": "readonly",
    "INACTIVITY_TIMEOUT": "readonly",
    "YEARS": "readonly",
    "SECTORS": "readonly",
    "REGIONS": "readonly",
    "supabase": "readonly",
    "bootstrap": "readonly",
    "utils": "readonly",
    "authModule": "readonly",
    "awardsModule": "readonly",
    "orgsModule": "readonly",
    "entriesModule": "readonly",
    "winnersModule": "readonly",
    "eventsModule": "readonly",
    "paymentsModule": "readonly",
    "crmModule": "readonly",
    "dashboardModule": "readonly",
    "rbacModule": "readonly",
    "securityModule": "readonly",
    "emailBuilderModule": "readonly",
    "emailTemplatesModule": "readonly",
    "emailListsModule": "readonly",
    "mediaGalleryModule": "readonly",
    "socialMediaModule": "readonly",
    "assignmentsModule": "readonly",
    "settingsModule": "readonly",
    "accessibilityModule": "readonly",
    "gdprModule": "readonly",
    "stripeFrontend": "readonly",
    "i18nModule": "readonly",
    "multiTenancy": "readonly",
    "testDataManager": "readonly",
    "reportingModule": "readonly",
    "sponsorPortalModule": "readonly",
    "ticketModule": "readonly",
    "notificationsModule": "readonly",
    "entryRevisionModule": "readonly",
    "winnerPipeline": "readonly",
    "brandingModule": "readonly",
    "webhooksModule": "readonly",
    "documentModule": "readonly",
    "seatingModule": "readonly",
    "calendarModule": "readonly",
    "rateLimitingModule": "readonly",
    "winnerAnnouncementsModule": "readonly",
    "reportsScheduler": "readonly",
    "aiVettingModule": "readonly",
    "marketingModule": "readonly",
    "apiClient": "readonly",
    "actionRegistry": "readonly",
    "serverQuery": "readonly",
    "L": "readonly",
    "Sentry": "readonly",
    "Stripe": "readonly",
    "Chart": "readonly",
    "XLSX": "readonly",
    "a11yModule": "readonly",
    "i18n": "readonly",
    "tenantModule": "readonly",
    "multiTenancyModule": "readonly",
    "emailBuilder": "readonly",
    "jsPDF": "readonly",
    "jspdf": "readonly",
    "Choices": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-redeclare": ["error", { "builtinGlobals": false }],
    "no-constant-condition": "warn",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-extra-semi": "warn",
    "no-unreachable": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-throw-literal": "warn",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn",
    "prefer-const": ["warn", { "destructuring": "all" }],
    "no-var": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["build.js", "check-schema.js", "diagnose.js", "bulk-csv-importer.js", "scripts/**/*.js"],
      "env": {
        "node": true,
        "browser": false
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["api/**/*.js"],
      "env": {
        "node": true,
        "browser": false
      },
      "globals": {},
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "env": {
        "jest": true,
        "node": true
      }
    }
  ]
}
