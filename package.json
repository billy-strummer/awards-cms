{
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint *.js api/*.js",
    "lint:fix": "eslint *.js api/*.js --fix",
    "test": "jest tests/ --forceExit",
    "test:coverage": "jest tests/ --forceExit --coverage",
    "typecheck": "npx -p typescript tsc --project jsconfig.json --noEmit --allowJs --checkJs 2>&1 || true",
    "validate": "npm run lint && npm run test && npm run build",
    "build": "node build.js"
  },
  "devDependencies": {
    "cssnano": "^7.1.2",
    "esbuild": "^0.27.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  }
}
