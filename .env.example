# ==================================================
# British Trade Awards CMS - Environment Variables
# ==================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Resend.com (Email)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=awards@britishtrade.com
FROM_NAME=British Trade Awards

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx

# Anthropic (AI Vetting)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Sentry (Error Monitoring)
SENTRY_DSN=https://xxxxxxxxxxxx@o123456.ingest.sentry.io/123456

# Branding
BTA_LOGO_URL=https://admin.britishtrade.com/assets/british-trade-awards-logo.png

# Twitter/X API
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_ORG_ID=your-linkedin-org-id

# Facebook / Instagram API
FACEBOOK_PAGE_TOKEN=your-facebook-page-token
FACEBOOK_PAGE_ID=your-facebook-page-id
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://admin.britishtrade.com
