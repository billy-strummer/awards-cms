{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "*": ["./*"]
    }
  },
  "include": [
    "*.js",
    "*.d.ts",
    "api/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "scripts",
    "tests"
  ]
}
